// Type-checks the browser-mode tests in tests/ (outside tsconfig.app.json's src/).
{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "vitest.setup.ts", "tests/**/*", "src/**/*.vue"],
  "exclude": [],
  "compilerOptions": {
    "types": ["@vitest/browser-playwright", "vitest-browser-vue"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
